@Api_HostAddress = https://localhost:7140

# @name login
POST {{Api_HostAddress}}/api/Usuario/cadastro
Content-Type: application/json

{
    "nome": "luis",
    "email": "luis@gmail.com",
    "senha": "1234567"
}

###
# @name login
POST {{Api_HostAddress}}/api/Usuario/login
Content-Type: application/json
{
    "email": "luis@gmail.com",
    "senha": "1234567"
}


###
POST {{Api_HostAddress}}/api/Produto/AddProduto
Content-Type: application/json
{
    "nomeproduto": "Arroz 5KG",
    "descricao": "Alimento",
    "preco": 20.50,
    "estoque": 50 

}

###
GET {{Api_HostAddress}}/api/Produto/Mostrar
Accept: application/json
Authorization: Bearer {{login.response.body.$.token}}


###
DELETE {{Api_HostAddress}}/api/Produto/Excluir/1
Accept: application/json


###
PUT {{Api_HostAddress}}/api/Produto/EditarProduto/1004
Content-Type: application/json

{
    "nomeproduto": "arroz 5KG",
    "descricao": "alimento",
    "preco": 20.5,
    "quantidade": 60,
    "totalvalor": 1230
}
